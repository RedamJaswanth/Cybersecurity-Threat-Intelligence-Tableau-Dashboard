  <actions />

  <worksheets>
    <!-- WORKSHEET 1: Target Countries Threat Exposure -->
    <worksheet name='Target Countries Threat Exposure'>
      <table>
        <view>
          <datasources>
            <datasource caption='Cybersecurity Threat Intelligence' name='federated.threat_intel_datasource' />
          </datasources>
          <datasource-dependencies datasource='federated.threat_intel_datasource'>
            <column datatype='string' name='[Target_Country]' role='dimension' type='nominal' />
            <column datatype='string' name='[Incident_ID]' role='dimension' type='nominal' />
            <column-instance column='[Target_Country]' derivation='None' name='[none:Target_Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Incident_ID]' derivation='Count' name='[cnt:Incident_ID:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.threat_intel_datasource].[cnt:Incident_ID:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.threat_intel_datasource].[none:Target_Country:nk]</rows>
        <cols>[federated.threat_intel_datasource].[cnt:Incident_ID:qk]</cols>
      </table>
      <simple-id uuid='{71C80B0F-0210-4A0F-970B-1E2E4DF85429}' />
    </worksheet>

    <!-- WORKSHEET 2: Active Threat Campaign Profiles -->
    <worksheet name='Active Threat Campaign Profiles'>
      <table>
        <view>
          <datasources>
            <datasource caption='Cybersecurity Threat Intelligence' name='federated.threat_intel_datasource' />
          </datasources>
          <datasource-dependencies datasource='federated.threat_intel_datasource'>
            <column datatype='string' name='[Threat_Actor]' role='dimension' type='nominal' />
            <column datatype='string' name='[Severity]' role='dimension' type='nominal' />
            <column datatype='string' name='[Incident_ID]' role='dimension' type='nominal' />
            <column-instance column='[Threat_Actor]' derivation='None' name='[none:Threat_Actor:nk]' pivot='key' type='nominal' />
            <column-instance column='[Severity]' derivation='None' name='[none:Severity:nk]' pivot='key' type='nominal' />
            <column-instance column='[Incident_ID]' derivation='Count' name='[cnt:Incident_ID:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.threat_intel_datasource].[none:Severity:nk]' type='palette'>
              <map to='#ef4444'>
                <bucket>&quot;Critical&quot;</bucket>
              </map>
              <map to='#f97316'>
                <bucket>&quot;High&quot;</bucket>
              </map>
              <map to='#eab308'>
                <bucket>&quot;Medium&quot;</bucket>
              </map>
              <map to='#22c55e'>
                <bucket>&quot;Low&quot;</bucket>
              </map>
            </encoding>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.threat_intel_datasource].[none:Severity:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.threat_intel_datasource].[none:Threat_Actor:nk]</rows>
        <cols>[federated.threat_intel_datasource].[cnt:Incident_ID:qk]</cols>
      </table>
      <simple-id uuid='{3A183D55-081B-45CE-B91F-72BC5288B11B}' />
