  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='GLOBAL CYBER THREAT INTELLIGENCE'>
      <style />
      <size sizing-mode='automatic' />
